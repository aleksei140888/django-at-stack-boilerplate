# Copy to .env (`make env-copy`) and fill in. Every variable read anywhere in
# config/settings/ is listed here — if it is not here, it does not exist.
#
# The test and demo layers do not need a .env at all: they set their own
# SECRET_KEY, so a fresh clone can run `make test` and `make demo-up` immediately.

# ── Django ────────────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# ── Site identity ─────────────────────────────────────────────────────────────
SITE_URL=http://localhost:8000
SITE_NAME=Django AT Stack

# Locale. Neutral defaults; set them per project rather than editing base.py.
LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# ── Database ──────────────────────────────────────────────────────────────────
# Any URL django-environ understands. sqlite:///db.sqlite3 works without Docker.
DATABASE_URL=postgres://postgres:postgres@db:5432/django_at_stack

# ── Redis (cache, Celery broker and result backend) ───────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Frontend ──────────────────────────────────────────────────────────────────
# True while `npm run dev` is running (assets from Vite with HMR); False serves
# the built bundle from static/dist. dev.py defaults this to True.
VITE_DEV_SERVER=True
VITE_DEV_SERVER_URL=http://localhost:5173

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com
# Where contact-form submissions go. Defaults to SERVER_EMAIL.
CONTACT_EMAIL=

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# console (human-readable) or json (one object per line, for a log shipper).
# prod.py forces json.
LOG_FORMAT=console
# /metrics stays 404 until this is set; the scraper sends it as a Bearer token.
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Object storage (optional) ─────────────────────────────────────────────────
# Setting AWS_STORAGE_BUCKET_NAME switches media uploads to S3. Static files are
# always served by WhiteNoise regardless.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
# S3-compatible providers (DigitalOcean Spaces, Cloudflare R2, MinIO).
AWS_S3_ENDPOINT_URL=
# CloudFront or another CDN hostname in front of the bucket.
AWS_S3_CUSTOM_DOMAIN=

# ── Security (production) ─────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# Comma-separated, needed once the site is behind HTTPS on a real domain.
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
